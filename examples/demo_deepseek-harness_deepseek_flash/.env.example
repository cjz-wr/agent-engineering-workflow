# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

APP_NAME=Mini Blog
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/blog.db
# REQUIRED: generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me

# If true, users may publish their own posts directly; if false, only admins can publish.
ALLOW_USER_PUBLISH=false
